# ---- Backend ----
# SQLite by default (zero-config). For PostgreSQL use e.g.:
# DATABASE_URL=postgresql+psycopg://user:password@localhost:5432/pocket_signals
DATABASE_URL=sqlite:///./data/signals.db

# Optional: if set, mutating endpoints (generate/push/settings) require header X-API-Key
API_KEY=

# CORS origins (comma separated). Vite dev proxy makes this unnecessary locally.
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# ---- Telegram (final delivery step) ----
# 1) Talk to @BotFather -> /newbot -> copy the token here (or set it in the dashboard UI)
# 2) Message your bot, then get your chat id (see README "Telegram setup")
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Signal automation ----
AUTO_SIGNALS_ENABLED=false
AUTO_PUSH_TELEGRAM=false
AUTO_INTERVAL_SECONDS=60
MIN_CONFIDENCE=60
WATCHLIST=EURUSD,GBPUSD,USDJPY,XAUUSD,BTCUSD
DEFAULT_TIMEFRAME=1m
DEFAULT_EXPIRY_MINUTES=2

# ---- Optional real market data (falls back to built-in simulator) ----
# Free key from https://twelvedata.com — leave empty to use simulated candles.
TWELVE_DATA_API_KEY=
